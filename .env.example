# Base de datos. Local: archivo SQLite. En la nube: URL de Turso (libsql://...) + token.
DATABASE_URL=file:./data/lanita.db
DATABASE_AUTH_TOKEN=

# Contraseña para entrar a la app. Déjala vacía para uso local sin contraseña.
APP_PASSWORD=

# Clave secreta para firmar la sesión y el enlace del calendario (cualquier texto largo y aleatorio).
APP_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Captura por chat con Claude (opcional). Sin esto, la captura rápida usa un lector básico.
ANTHROPIC_API_KEY=
